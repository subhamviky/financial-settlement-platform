{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/subhamviky/financial-settlement-platform/contracts/events/settlement-event.v1.schema.json",
  "title": "Settlement event envelope, version 1",
  "description": "Published by settlement-service through its transactional outbox; consumed by audit-ai-service and (later) the reconciliation engine. Additive changes keep version 1; anything else is a new schema version.",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "tenant_id", "correlation_id", "settlement"],
  "additionalProperties": false,
  "properties": {
    "event_id": {"type": "string", "format": "uuid", "description": "Unique per event; consumers de-duplicate on it."},
    "event_type": {"enum": ["ledger.posted", "settlement.completed", "settlement.compensated", "settlement.rejected", "ledger.adjusted"]},
    "schema_version": {"const": "1"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "settlement": {
      "type": "object",
      "required": ["settlement_id", "payer_account", "payee_account", "amount", "currency", "status", "reason"],
      "additionalProperties": false,
      "properties": {
        "settlement_id": {"type": "string", "format": "uuid"},
        "payer_account": {"type": "string", "minLength": 1},
        "payee_account": {"type": "string", "minLength": 1},
        "amount": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$", "description": "Decimal as a string, two fraction digits: no floating-point rounding."},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "status": {"enum": ["RECEIVED", "LEDGER_POSTED", "COMPLETED", "COMPENSATING", "COMPENSATED", "REJECTED"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "adjustment": {
      "description": "Only on ledger.adjusted (added in v1, additive): a write-off or refund of the completed settlement.",
      "type": "object",
      "required": ["adjustment_id", "type", "amount", "debit_account", "credit_account", "reason", "reference"],
      "additionalProperties": false,
      "properties": {
        "adjustment_id": {"type": "string", "format": "uuid"},
        "type": {"enum": ["WRITE_OFF", "REFUND"]},
        "amount": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "debit_account": {"type": "string", "minLength": 1},
        "credit_account": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1}
      }
    }
  },
  "if": {"properties": {"event_type": {"const": "ledger.adjusted"}}},
  "then": {"required": ["adjustment"]},
  "else": {"not": {"required": ["adjustment"]}}
}
