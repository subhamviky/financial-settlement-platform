# settlement-service — Azure service landing zone (generated by A2C IaCAgent).
# Container App (with a user-assigned identity) on a Log Analytics backed
# environment, a Service Bus queue whose dead-letter sub-queue catches
# poison messages, and a Key Vault for secrets (values set out of band).
# Environment-specific values are variables; no secrets here.

terraform {
  required_version = ">= 1.7"
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 5.0"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

variable "subscription_id" {
  type        = string
  description = "Azure subscription id."
}

variable "location" {
  type        = string
  description = "Azure region."
  default     = "centralindia"
}

variable "environment" {
  type        = string
  description = "Deployment environment name (dev, test, prod)."
  default     = "dev"
}

variable "image" {
  type        = string
  description = "Container image built and pushed by CI."
  default     = "mcr.microsoft.com/k8se/quickstart:latest"
}

variable "container_port" {
  type        = number
  description = "Port the container listens on (the P0 Dockerfile's port)."
  default     = 8080
}

variable "health_path" {
  type        = string
  description = "HTTP path of the liveness probe."
  default     = "/health"
}

variable "max_delivery_count" {
  type        = number
  description = "Deliveries before a message moves to the dead-letter sub-queue."
  default     = 5
}

locals {
  name = "settlement-service-${var.environment}"
  tags = {
    project     = "settlement-service"
    environment = var.environment
    managed_by  = "terraform"
  }
}

data "azurerm_client_config" "current" {}

resource "azurerm_resource_group" "app" {
  name     = "rg-${local.name}"
  location = var.location
  tags     = local.tags
}

# ------------------------------------------------------------ observability
resource "azurerm_log_analytics_workspace" "app" {
  name                = "log-${local.name}"
  location            = azurerm_resource_group.app.location
  resource_group_name = azurerm_resource_group.app.name
  sku                 = "PerGB2018"
  retention_in_days   = 30
  tags                = local.tags
}

# ---------------------------------------------------------------- identity
resource "azurerm_user_assigned_identity" "app" {
  name                = "id-${local.name}"
  location            = azurerm_resource_group.app.location
  resource_group_name = azurerm_resource_group.app.name
  tags                = local.tags
}

# ---------------------------------------------------------------- messaging
resource "azurerm_servicebus_namespace" "app" {
  name                = "sb-${local.name}"
  location            = azurerm_resource_group.app.location
  resource_group_name = azurerm_resource_group.app.name
  sku                 = "Standard"
  tags                = local.tags
}

resource "azurerm_servicebus_queue" "events" {
  name                                 = "events"
  namespace_id                         = azurerm_servicebus_namespace.app.id
  max_delivery_count                   = var.max_delivery_count
  dead_lettering_on_message_expiration = true
}

resource "azurerm_role_assignment" "queue_receiver" {
  scope                = azurerm_servicebus_namespace.app.id
  role_definition_name = "Azure Service Bus Data Receiver"
  principal_id         = azurerm_user_assigned_identity.app.principal_id
}

# ------------------------------------------------------------------ secrets
resource "azurerm_key_vault" "app" {
  name                       = replace(substr("kv-${local.name}", 0, 24), "/-+$/", "")
  location                   = azurerm_resource_group.app.location
  resource_group_name        = azurerm_resource_group.app.name
  tenant_id                  = data.azurerm_client_config.current.tenant_id
  sku_name                   = "standard"
  rbac_authorization_enabled = true
  purge_protection_enabled   = true
  soft_delete_retention_days = 7
  tags                       = local.tags
}

resource "azurerm_role_assignment" "secrets_reader" {
  scope                = azurerm_key_vault.app.id
  role_definition_name = "Key Vault Secrets User"
  principal_id         = azurerm_user_assigned_identity.app.principal_id
}

# ------------------------------------------------------------------ compute
resource "azurerm_container_app_environment" "app" {
  name                       = "cae-${local.name}"
  location                   = azurerm_resource_group.app.location
  resource_group_name        = azurerm_resource_group.app.name
  log_analytics_workspace_id = azurerm_log_analytics_workspace.app.id
  tags                       = local.tags
}

resource "azurerm_container_app" "app" {
  name                         = "ca-${local.name}"
  container_app_environment_id = azurerm_container_app_environment.app.id
  resource_group_name          = azurerm_resource_group.app.name
  revision_mode                = "Single"
  tags                         = local.tags

  identity {
    type         = "UserAssigned"
    identity_ids = [azurerm_user_assigned_identity.app.id]
  }

  template {
    min_replicas = 0
    max_replicas = 3
    container {
      name   = "app"
      image  = var.image
      cpu    = 0.5
      memory = "1Gi"
      env {
        name  = "SERVICEBUS_NAMESPACE"
        value = azurerm_servicebus_namespace.app.name
      }
      env {
        name  = "KEY_VAULT_URI"
        value = azurerm_key_vault.app.vault_uri
      }
      liveness_probe {
        transport = "HTTP"
        port      = var.container_port
        path      = var.health_path
      }
    }
  }

  ingress {
    external_enabled = true
    target_port      = var.container_port
    traffic_weight {
      percentage      = 100
      latest_revision = true
    }
  }
}

output "app_fqdn" {
  value = azurerm_container_app.app.ingress[0].fqdn
}

output "servicebus_queue" {
  value = azurerm_servicebus_queue.events.name
}
