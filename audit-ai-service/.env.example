# Application
APP_NAME=audit-ai-service
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Cloud Platform (azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4o

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=audit-ai-service

# E2A Framework NFRs
MIN_CONFIDENCE=0.85
MAX_LATENCY=2.0
MAX_TOKENS=5000
TOOL_TIMEOUT=5.0
TOOL_RETRIES=3
