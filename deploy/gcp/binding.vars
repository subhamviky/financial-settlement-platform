# Google Cloud binding of the settlement platform (hub design note GCP-01). PLACEHOLDERS until the
# account exists: filled at cutover. Nothing secret belongs here: the database password and the Gemini
# key live in Secret Manager, which is why this is .vars and not .env (the repository ignores *.env).
# settlement-service/infra/gcp and audit-ai-service/infra/gcp read these as TF_VAR_*.
GCP_PROJECT_ID=finance-ai-landscape-PLACEHOLDER
# Always Free e2-micro regions only: us-west1, us-central1, us-east1
GCP_REGION=us-central1
# images pushed by CI to the landscape's Artifact Registry (infra/foundation of enterprise-finance-genai-assistant)
SETTLEMENT_IMAGE=us-central1-docker.pkg.dev/finance-ai-landscape-PLACEHOLDER/landscape/settlement-service:latest
AUDIT_IMAGE=us-central1-docker.pkg.dev/finance-ai-landscape-PLACEHOLDER/landscape/audit-ai-service:latest
# postgres mirrored into the same registry (the ledger VM has no external IP; Private Google Access only)
POSTGRES_IMAGE=us-central1-docker.pkg.dev/finance-ai-landscape-PLACEHOLDER/landscape/postgres:16-alpine
# settlement-service's Cloud Run URL, known after its first apply (audit-ai reads the event feed from it)
SETTLEMENT_API_URL=https://settlement-service-PLACEHOLDER.us-central1.run.app
# simulated (no key) or gemini_api (free tier; the key in Secret Manager under this id)
E2A_PROVIDER_PROFILE=simulated
GEMINI_API_KEY_SECRET=
LLM_MODEL_ID=
# who else may call the services (comma-separated): the assistant's, reconciliation's and O2C's service accounts
INVOKER_MEMBERS=serviceAccount:genai-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com,serviceAccount:recon-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com,serviceAccount:o2c-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com
